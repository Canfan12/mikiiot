{
  "entities": {
    "Device": {
      "title": "Device",
      "description": "Smart Home IoT device data.",
      "type": "object",
      "properties": {
        "temperature": {
          "type": "number",
          "description": "Temperature in Celsius"
        },
        "humidity": {
          "type": "number",
          "description": "Humidity in percentage"
        },
        "relay1": {
          "type": "boolean",
          "description": "Relay 1 status"
        },
        "relay2": {
          "type": "boolean",
          "description": "Relay 2 status"
        },
        "relay3": {
          "type": "boolean",
          "description": "Relay 3 status"
        },
        "relay4": {
          "type": "boolean",
          "description": "Relay 4 status"
        },
        "lastUpdated": {
          "type": "number",
          "description": "Timestamp of the last update"
        }
      },
      "required": ["temperature", "humidity", "relay1", "relay2", "relay3", "relay4", "lastUpdated"]
    }
  },
  "firestore": {
    "/devices/{deviceId}": {
      "schema": {
        "$ref": "#/entities/Device"
      },
      "description": "Stores the latest sensor data and relay statuses for a specific device."
    }
  }
}
